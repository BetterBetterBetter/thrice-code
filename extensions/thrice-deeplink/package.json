{
	"name": "thrice-deeplink",
	"displayName": "Thrice Deeplink",
	"description": "Registers the deeplink debug command. The URI grammar is unconfirmed, so links are not parsed.",
	"version": "10.0.0",
	"publisher": "thrice",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"activationEvents": [
		"onStartupFinished",
		"onUri"
	],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:thrice-deeplink",
		"watch": "gulp watch-extension:thrice-deeplink"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "thrice.deeplink.debug.triggerDeeplink",
				"title": "Debug: Trigger Arbitrary Deeplink",
				"category": "Thrice Deeplink"
			}
		]
	}
}
