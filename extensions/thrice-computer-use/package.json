{
	"name": "thrice-computer-use",
	"displayName": "Thrice Computer Use",
	"description": "Names an open session. Tool arguments, screenshot bytes, and the socket path are unconfirmed.",
	"version": "10.0.0",
	"publisher": "thrice",
	"license": "MIT",
	"engines": { "vscode": "*" },
	"activationEvents": ["onStartupFinished"],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:thrice-computer-use",
		"watch": "gulp watch-extension:thrice-computer-use"
	},
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": { "supported": true }
	}
}
