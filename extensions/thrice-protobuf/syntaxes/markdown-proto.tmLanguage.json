{
	"scopeName": "markdown.protobuf.codeblock",
	"injectionSelector": "L:text.html.markdown",
	"patterns": [
		{
			"begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(proto|protobuf)\\s*$",
			"end": "\\2\\3",
			"contentName": "meta.embedded.block.proto",
			"patterns": [
				{
					"include": "source.proto"
				}
			]
		}
	]
}
